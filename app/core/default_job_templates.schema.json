{
  "$defs": {
    "JobTemplateSchema": {
      "properties": {
        "title": {
          "description": "Official job title",
          "maxLength": 255,
          "minLength": 2,
          "title": "Title",
          "type": "string"
        },
        "category": {
          "default": "General",
          "description": "Department or job category",
          "maxLength": 100,
          "title": "Category",
          "type": "string"
        },
        "description": {
          "description": "Full job description requirements and specs",
          "minLength": 10,
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "title",
        "description"
      ],
      "title": "JobTemplateSchema",
      "type": "object"
    },
    "SystemSettingsDefaultsSchema": {
      "properties": {
        "project_name": {
          "default": "Kayatix - A.Y.A.T. Engine",
          "description": "Default project or platform name",
          "title": "Project Name",
          "type": "string"
        },
        "version": {
          "default": "1.0.0",
          "description": "Default application version",
          "title": "Version",
          "type": "string"
        },
        "subscription_tier": {
          "default": "standard",
          "description": "Default subscription tier",
          "title": "Subscription Tier",
          "type": "string"
        },
        "evaluation_mode": {
          "default": "llm_cascade",
          "description": "Default candidate evaluation mode",
          "title": "Evaluation Mode",
          "type": "string"
        },
        "rate_limit_rpm": {
          "default": 15,
          "description": "Default rate limit in requests per minute",
          "maximum": 1000,
          "minimum": 1,
          "title": "Rate Limit Rpm",
          "type": "integer"
        }
      },
      "title": "SystemSettingsDefaultsSchema",
      "type": "object"
    }
  },
  "properties": {
    "version": {
      "default": "1.0.0",
      "description": "Schema specification version",
      "title": "Version",
      "type": "string"
    },
    "modified_timestamp": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": "2026-10-16T19:00:00Z",
      "description": "ISO timestamp marking when the schema file was last modified",
      "title": "Modified Timestamp"
    },
    "system_settings": {
      "$ref": "#/$defs/SystemSettingsDefaultsSchema",
      "description": "System configuration defaults"
    },
    "job_templates": {
      "description": "List of standard job description templates",
      "items": {
        "$ref": "#/$defs/JobTemplateSchema"
      },
      "title": "Job Templates",
      "type": "array"
    }
  },
  "title": "AppDefaultsSchema",
  "type": "object"
}
# Server Database Connection URL (PostgreSQL / Neon / Supabase / RDS)
DATABASE_URL="postgresql+asyncpg://user:password@host:port/dbname?ssl=require"

# Default Administrator Account (Bootstrapped securely on startup)
ADMIN_EMAIL="admin@kayatix.local"
ADMIN_PASSWORD="ChangeThisAdminPassword123!"
ADMIN_FULL_NAME="Platform Administrator"

# Authentication Secret Key (Used to cryptographically sign session JWT tokens)
SECRET_KEY="kayatix-super-secret-key-change-this-in-production-use-random-bytes"
